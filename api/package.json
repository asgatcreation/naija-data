{
  "name": "naija-data-api",
  "private": true,
  "version": "1.0.0",
  "description": "Public REST API for naija-data (Cloudflare Worker).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=.test/worker.mjs --log-level=warning && node --test test/api.test.mjs"
  },
  "dependencies": {
    "naija-data": "file:../packages/js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.145.0"
  }
}
