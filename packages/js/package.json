{
  "name": "naija-data",
  "version": "0.1.0-dev.0",
  "description": "Accurate, sourced Nigerian reference data: states, LGAs, wards, banks, NUBAN and phone helpers.",
  "keywords": [
    "nigeria",
    "states",
    "lga",
    "wards",
    "banks",
    "nuban",
    "phone",
    "open-data"
  ],
  "author": "Akanji Oluwaseun Gabriel",
  "license": "(MIT AND CC-BY-4.0)",
  "homepage": "https://github.com/asgatcreation/naija-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asgatcreation/naija-data.git",
    "directory": "packages/js"
  },
  "bugs": "https://github.com/asgatcreation/naija-data/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./wards": {
      "import": {
        "types": "./dist/wards.d.ts",
        "default": "./dist/wards.js"
      },
      "require": {
        "types": "./dist/wards.d.cts",
        "default": "./dist/wards.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "naija": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/api.test.mjs test/parity.test.mjs",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
