{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asgatcreation/naija-data/schemas/phone_prefixes.schema.json",
  "title": "Mobile number block allocated by the NCC",
  "description": "One row of the CSV file. Empty cells are empty strings; lists are separated by '|'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prefix",
    "range_start",
    "range_end",
    "operator",
    "status",
    "ncc_label",
    "sources"
  ],
  "properties": {
    "prefix": {
      "type": "string",
      "pattern": "^0[789]\\d{2}$"
    },
    "range_start": {
      "type": "string",
      "pattern": "^\\d{7}$"
    },
    "range_end": {
      "type": "string",
      "pattern": "^\\d{7}$"
    },
    "operator": {
      "type": "string",
      "pattern": "^$|^\\S(.*\\S)?$"
    },
    "status": {
      "enum": [
        "allocated",
        "shared_vas",
        "reserved_vanity",
        "withdrawn",
        "returned",
        "available"
      ]
    },
    "ncc_label": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "sources": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\|[a-z0-9-]+)*$"
    }
  },
  "allOf": [
    {
      "properties": {
        "prefix": {
          "minLength": 1
        },
        "status": {
          "minLength": 1
        }
      }
    }
  ]
}
