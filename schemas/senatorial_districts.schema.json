{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asgatcreation/naija-data/schemas/senatorial_districts.schema.json",
  "title": "Senatorial district (Senate)",
  "description": "One row of the CSV file. Empty cells are empty strings; lists are separated by '|'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "state_code",
    "inec_code",
    "name",
    "slug",
    "aliases",
    "sources"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^SD\\d{3}$",
      "description": "SD + INEC's number for the unit"
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "inec_code": {
      "type": "string",
      "pattern": "^SD/\\d{2,3}/[A-Z]{2,3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "string",
      "pattern": "^$|^[^|\\s][^|]*[^|\\s]?(\\|[^|\\s][^|]*[^|\\s]?)*$"
    },
    "sources": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\|[a-z0-9-]+)*$"
    }
  }
}
