{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asgatcreation/naija-data/schemas/sources.schema.json",
  "title": "Data sources (provenance registry)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "publisher",
      "url",
      "retrieved",
      "licence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "publisher": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^https://"
      },
      "retrieved": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "licence": {
        "enum": [
          "CC0-1.0",
          "CC-BY-4.0",
          "CC-BY-IGO-3.0",
          "Unicode-3.0",
          "public-law",
          "facts-only",
          "not-redistributable"
        ],
        "description": "facts-only: no open licence is published, so only plain facts (names, codes, prefixes) are used and no text is copied. not-redistributable: referenced for format only, no records copied."
      },
      "notes": {
        "type": "string"
      },
      "archive_url": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  }
}
