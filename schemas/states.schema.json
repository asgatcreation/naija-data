{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asgatcreation/naija-data/schemas/states.schema.json",
  "title": "State or FCT",
  "description": "One row of the CSV file. Empty cells are empty strings; lists are separated by '|'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "iso_code",
    "name",
    "slug",
    "inec_code",
    "pcode",
    "capital",
    "zone",
    "created",
    "lat",
    "lon",
    "aliases",
    "unverified_fields",
    "sources"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "iso_code": {
      "type": "string",
      "pattern": "^NG-[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "inec_code": {
      "type": "string",
      "pattern": "^\\d{2}$"
    },
    "pcode": {
      "type": "string",
      "pattern": "^NG\\d{3}$"
    },
    "capital": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "zone": {
      "enum": [
        "North-Central",
        "North-East",
        "North-West",
        "South-East",
        "South-South",
        "South-West"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lat": {
      "type": "string",
      "pattern": "^-?\\d{1,3}\\.\\d{1,5}$"
    },
    "lon": {
      "type": "string",
      "pattern": "^-?\\d{1,3}\\.\\d{1,5}$"
    },
    "aliases": {
      "type": "string",
      "pattern": "^$|^[^|\\s][^|]*[^|\\s]?(\\|[^|\\s][^|]*[^|\\s]?)*$"
    },
    "unverified_fields": {
      "type": "string",
      "pattern": "^$|^(created|capital)(\\|(created|capital))*$"
    },
    "sources": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\|[a-z0-9-]+)*$"
    }
  },
  "allOf": [
    {
      "properties": {
        "code": {
          "minLength": 1
        },
        "name": {
          "minLength": 1
        },
        "slug": {
          "minLength": 1
        },
        "capital": {
          "minLength": 1
        }
      }
    }
  ]
}
