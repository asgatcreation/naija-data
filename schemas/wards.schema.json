{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asgatcreation/naija-data/schemas/wards.schema.json",
  "title": "Ward / INEC registration area",
  "description": "One row of the CSV file. Empty cells are empty strings; lists are separated by '|'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "lga_code",
    "state_code",
    "name",
    "slug",
    "senatorial_district",
    "federal_constituency",
    "state_constituency",
    "aliases",
    "unverified_fields",
    "sources"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$"
    },
    "lga_code": {
      "type": "string",
      "pattern": "^NG\\d{6}$"
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "senatorial_district": {
      "type": "string",
      "pattern": "^SD\\d{3}$"
    },
    "federal_constituency": {
      "type": "string",
      "pattern": "^FC\\d{3}$"
    },
    "state_constituency": {
      "type": "string",
      "pattern": "^$|^SC\\d{3}$",
      "description": "Empty for FCT wards: the FCT has no House of Assembly."
    },
    "aliases": {
      "type": "string",
      "pattern": "^$|^[^|\\s][^|]*[^|\\s]?(\\|[^|\\s][^|]*[^|\\s]?)*$"
    },
    "unverified_fields": {
      "type": "string",
      "pattern": "^$|^state_constituency$"
    },
    "sources": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\|[a-z0-9-]+)*$"
    }
  },
  "allOf": [
    {
      "properties": {
        "code": {
          "minLength": 1
        },
        "name": {
          "minLength": 1
        },
        "slug": {
          "minLength": 1
        }
      }
    }
  ]
}
